# Names only. Put real values in server/.env.local (gitignored); Bun loads it on `bun run dev`.

# payments.lk secret key (sk_test_... or sk_live_...); its prefix sets the server mode.
PAYMENTS_LK_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...).
PAYMENTS_LK_WEBHOOK_SECRET=

# Text of the minisign license secret key file (unencrypted). Its key ID must be D0E563203A52E5F9.
LICENSE_SECRET_KEY=
# Highest app major version new Pro licenses cover.
LICENSE_MAJOR=1
# Pro price in LKR cents (1000 to 100000000).
PRO_PRICE_CENTS=

# Public site URL: the only CORS origin, and the base of success, cancel and activate links.
SITE_URL=http://localhost:3000
DATABASE_PATH=./disklens.db
PORT=8787

# Sender address verified in SES.
MAIL_FROM=
# 1 writes emails to server/.mail instead of sending. Refused in live mode.
MAIL_DRY_RUN=1
# AWS default credential chain, used for SES.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 1 reads the client IP from the first X-Forwarded-For hop (only behind a trusted proxy).
TRUST_PROXY=
